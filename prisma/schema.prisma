generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  OPERATOR
  CLIENT
  READ_ONLY
}

enum DocumentType {
  PRIVACY_POLICY
  RODO_POLICY
  PROCESSING_REGISTER
  PROCESSING_AGREEMENT
  DPIA
  COOKIE_POLICY
  DATA_BREACH_PROCEDURE
  DATA_SUBJECT_REQUEST_PROCEDURE
  CLEAN_DESK_POLICY
  IT_SECURITY_INSTRUCTION
  AUTHORIZATION_TEMPLATE
  TRAINING_MATERIAL
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  DELIVERED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductKind {
  DOCUMENT
  SERVICE
  PACKAGE
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderItemFulfillmentStatus {
  NOT_STARTED
  READY_FOR_INPUT
  INPUT_IN_PROGRESS
  INPUT_SUBMITTED
  GENERATION_PENDING
  GENERATED
  DELIVERED
  CANCELLED
  FAILED
}

enum DocumentInputStatus {
  DRAFT
  SUBMITTED
  LOCKED
  GENERATION_PENDING
  GENERATED
  NEEDS_CORRECTION
  CANCELLED
}

enum LeadSource {
  IOD_CHECKER
  CONTACT_FORM
  MANUAL
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  TO_CONTACT
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  PROPOSAL_SENT
  CONVERTED
  WON
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrganizationStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CrmNoteVisibility {
  INTERNAL
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfiles     ClientProfile[]
  createdTemplates   DocumentTemplate[]      @relation("TemplateCreatedBy")
  approvedTemplates  DocumentTemplate[]      @relation("TemplateApprovedBy")
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]
  orders             Order[]
  orderItems         OrderItem[]
  createdInputs      DocumentInput[]         @relation("DocumentInputCreatedBy")
  updatedInputs      DocumentInput[]         @relation("DocumentInputUpdatedBy")
  submittedInputs    DocumentInput[]         @relation("DocumentInputSubmittedBy")
  assignedLeads      Lead[]                  @relation("LeadAssignedTo")
  ownedOrganizations Organization[]          @relation("OrganizationOwner")
  authoredCrmNotes   CrmNote[]
  assignedCrmTasks   CrmTask[]               @relation("CrmTaskAssignedTo")
  createdCrmTasks    CrmTask[]               @relation("CrmTaskCreatedBy")
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  nip          String?
  regon        String?
  website      String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?            @default("PL")
  legalName    String?
  industry     String?
  size         String?
  status       OrganizationStatus @default(PROSPECT)
  ownerId      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner              User?                   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientProfiles     ClientProfile[]
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]
  orders             Order[]
  orderItems         OrderItem[]
  documentInputs     DocumentInput[]
  leads              Lead[]
  contactPersons     ContactPerson[]
  crmNotes           CrmNote[]
  crmTasks           CrmTask[]

  @@index([ownerId])
  @@index([status, createdAt])
  @@index([name])
  @@index([nip])
}

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model DocumentTemplate {
  id              String                 @id @default(cuid())
  type            DocumentType
  name            String
  version         Int
  status          DocumentTemplateStatus @default(DRAFT)
  fileKey         String
  variablesSchema Json
  createdById     String
  approvedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  createdBy          User                    @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?                   @relation("TemplateApprovedBy", fields: [approvedById], references: [id])
  products           Product[]
  orderItems         OrderItem[]
  documentInputs     DocumentInput[]
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@unique([type, version])
  @@index([status])
}

model Product {
  id            String        @id @default(cuid())
  kind          ProductKind   @default(DOCUMENT)
  status        ProductStatus @default(ACTIVE)
  name          String
  slug          String        @unique
  description   String?
  templateId    String?
  documentType  DocumentType?
  priceNetCents Int           @default(0)
  vatRateBps    Int           @default(2300)
  currency      String        @default("PLN")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  documentInputs DocumentInput[]

  @@index([kind, status])
  @@index([templateId])
}

model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  organizationId  String
  buyerEmail      String
  buyerName       String
  paymentStatus   OrderPaymentStatus @default(PENDING)
  currency        String             @default("PLN")
  totalNetCents   Int                @default(0)
  totalVatCents   Int                @default(0)
  totalGrossCents Int                @default(0)
  createdById     String?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  documentInputs DocumentInput[]

  @@index([organizationId])
  @@index([paymentStatus, createdAt])
  @@index([createdById])
}

model OrderItem {
  id                String                     @id @default(cuid())
  orderId           String
  organizationId    String
  productId         String?
  templateId        String?
  documentType      DocumentType?
  name              String
  quantity          Int                        @default(1)
  unitNetCents      Int                        @default(0)
  vatRateBps        Int                        @default(2300)
  totalGrossCents   Int                        @default(0)
  fulfillmentStatus OrderItemFulfillmentStatus @default(NOT_STARTED)
  createdById       String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  template      DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  documentInput DocumentInput?

  @@index([orderId])
  @@index([organizationId])
  @@index([productId])
  @@index([templateId])
  @@index([fulfillmentStatus])
}

model DocumentInput {
  id                String              @id @default(cuid())
  organizationId    String
  orderId           String?
  orderItemId       String              @unique
  productId         String?
  templateId        String
  templateVersion   Int?
  documentType      DocumentType
  status            DocumentInputStatus @default(DRAFT)
  dataJson          Json
  validationSummary Json?
  clientRevision    Int                 @default(1)
  createdById       String
  updatedById       String?
  submittedById     String?
  submittedAt       DateTime?
  lockedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order          Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem      OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product        Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  template       DocumentTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("DocumentInputCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?                   @relation("DocumentInputUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  submittedBy    User?                   @relation("DocumentInputSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  generationJobs DocumentGenerationJob[]

  @@index([organizationId])
  @@index([orderId])
  @@index([productId])
  @@index([templateId])
  @@index([status, updatedAt])
  @@index([createdById])
}

model DocumentGenerationJob {
  id              String                   @id @default(cuid())
  organizationId  String
  templateId      String
  documentInputId String?
  status          DocumentGenerationStatus @default(PENDING)
  inputSnapshot   Json
  errorMessage    String?
  createdById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  completedAt     DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id])
  template          DocumentTemplate   @relation(fields: [templateId], references: [id])
  documentInput     DocumentInput?     @relation(fields: [documentInputId], references: [id], onDelete: SetNull)
  createdBy         User               @relation(fields: [createdById], references: [id])
  generatedDocument GeneratedDocument?

  @@index([organizationId])
  @@index([templateId])
  @@index([documentInputId])
  @@index([status])
}

model GeneratedDocument {
  id              String                  @id @default(cuid())
  organizationId  String
  templateId      String
  templateVersion Int
  generationJobId String                  @unique
  type            DocumentType
  status          GeneratedDocumentStatus @default(DRAFT)
  inputSnapshot   Json
  docxFileKey     String
  pdfFileKey      String?
  zipFileKey      String?
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id])
  template      DocumentTemplate      @relation(fields: [templateId], references: [id])
  generationJob DocumentGenerationJob @relation(fields: [generationJobId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FormSubmission {
  id             String               @id @default(cuid())
  organizationId String
  formType       String
  status         FormSubmissionStatus @default(DRAFT)
  data           Json
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])
  lead         Lead?

  @@index([organizationId])
  @@index([formType])
  @@index([status])
}

model Lead {
  id                        String       @id @default(cuid())
  source                    LeadSource   @default(MANUAL)
  status                    LeadStatus   @default(NEW)
  priority                  LeadPriority @default(NORMAL)
  companyName               String
  fullName                  String
  email                     String
  phone                     String?
  nip                       String?
  industry                  String?
  companySize               String?
  estimatedValue            Decimal?     @db.Decimal(12, 2)
  consentMarketing          Boolean      @default(false)
  consentPrivacy            Boolean      @default(false)
  consentContact            Boolean      @default(false)
  iodCheckerResult          String?
  iodCheckerAnswersSnapshot Json?
  sourceDetails             Json?
  assignedToId              String?
  organizationId            String?
  formSubmissionId          String?      @unique
  convertedAt               DateTime?
  lastContactedAt           DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  contactPersons ContactPerson[]
  notes          CrmNote[]
  tasks          CrmTask[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([priority, createdAt])
  @@index([assignedToId])
  @@index([organizationId])
  @@index([email])
  @@index([companyName])
  @@index([nip])
}

model ContactPerson {
  id             String   @id @default(cuid())
  leadId         String?
  organizationId String?
  fullName       String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([organizationId])
  @@index([email])
}

model CrmNote {
  id             String            @id @default(cuid())
  leadId         String?
  organizationId String?
  authorId       String
  body           String
  visibility     CrmNoteVisibility @default(INTERNAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId])
}

model CrmTask {
  id             String        @id @default(cuid())
  leadId         String?
  organizationId String?
  title          String
  description    String?
  status         CrmTaskStatus @default(OPEN)
  priority       LeadPriority  @default(NORMAL)
  dueAt          DateTime?
  assignedToId   String?
  createdById    String
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignedTo   User?         @relation("CrmTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, status])
  @@index([organizationId, status])
  @@index([assignedToId, status, dueAt])
  @@index([createdById])
  @@index([dueAt])
}
