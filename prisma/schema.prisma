generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  OPERATOR
  CLIENT
  READ_ONLY
}

enum DocumentType {
  PRIVACY_POLICY
  RODO_POLICY
  PROCESSING_REGISTER
  PROCESSING_AGREEMENT
  DPIA
  COOKIE_POLICY
  DATA_BREACH_PROCEDURE
  DATA_SUBJECT_REQUEST_PROCEDURE
  CLEAN_DESK_POLICY
  IT_SECURITY_INSTRUCTION
  AUTHORIZATION_TEMPLATE
  TRAINING_MATERIAL
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  DELIVERED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadSource {
  IOD_CHECKER
  CONTACT_FORM
  MANUAL
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  TO_CONTACT
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  PROPOSAL_SENT
  CONVERTED
  WON
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrganizationStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CrmNoteVisibility {
  INTERNAL
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DataBreachIncidentStatus {
  DRAFT
  REPORTED
  TRIAGE
  RISK_ASSESSMENT
  NOTIFICATION_REQUIRED
  NOTIFICATION_NOT_REQUIRED
  NOTIFIED_AUTHORITY
  NOTIFIED_DATA_SUBJECTS
  CLOSED
  CANCELLED
}

enum DataBreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataBreachRiskLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum DataBreachActivityType {
  CREATED
  SUBMITTED
  UPDATED
  STATUS_CHANGED
  RISK_ASSESSMENT_UPDATED
  NOTIFICATION_DECISION_CHANGED
  NOTE_ADDED
  TASK_CREATED
  CLOSED
}

enum DataBreachActivityVisibility {
  INTERNAL
  PUBLIC
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfiles     ClientProfile[]
  createdTemplates   DocumentTemplate[]      @relation("TemplateCreatedBy")
  approvedTemplates  DocumentTemplate[]      @relation("TemplateApprovedBy")
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]
  assignedLeads      Lead[]                  @relation("LeadAssignedTo")
  ownedOrganizations Organization[]          @relation("OrganizationOwner")
  authoredCrmNotes   CrmNote[]
  assignedCrmTasks   CrmTask[]               @relation("CrmTaskAssignedTo")
  createdCrmTasks    CrmTask[]               @relation("CrmTaskCreatedBy")
  reportedBreaches   DataBreachIncident[]    @relation("BreachReportedBy")
  assignedBreaches   DataBreachIncident[]    @relation("BreachAssignedTo")
  breachActivities   DataBreachActivity[]    @relation("BreachActivityActor")
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  nip          String?
  regon        String?
  website      String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?            @default("PL")
  legalName    String?
  industry     String?
  size         String?
  status       OrganizationStatus @default(PROSPECT)
  ownerId      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner              User?                   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientProfiles     ClientProfile[]
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]
  leads              Lead[]
  contactPersons     ContactPerson[]
  crmNotes           CrmNote[]
  crmTasks           CrmTask[]
  breachIncidents    DataBreachIncident[]

  @@index([ownerId])
  @@index([status, createdAt])
  @@index([name])
  @@index([nip])
}

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model DocumentTemplate {
  id              String                 @id @default(cuid())
  type            DocumentType
  name            String
  version         Int
  status          DocumentTemplateStatus @default(DRAFT)
  fileKey         String
  variablesSchema Json
  createdById     String
  approvedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  createdBy          User                    @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?                   @relation("TemplateApprovedBy", fields: [approvedById], references: [id])
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@unique([type, version])
  @@index([status])
}

model DocumentGenerationJob {
  id             String                   @id @default(cuid())
  organizationId String
  templateId     String
  status         DocumentGenerationStatus @default(PENDING)
  inputSnapshot  Json
  errorMessage   String?
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  completedAt    DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id])
  template          DocumentTemplate   @relation(fields: [templateId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  generatedDocument GeneratedDocument?

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model GeneratedDocument {
  id              String                  @id @default(cuid())
  organizationId  String
  templateId      String
  templateVersion Int
  generationJobId String                  @unique
  type            DocumentType
  status          GeneratedDocumentStatus @default(DRAFT)
  inputSnapshot   Json
  docxFileKey     String
  pdfFileKey      String?
  zipFileKey      String?
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id])
  template      DocumentTemplate      @relation(fields: [templateId], references: [id])
  generationJob DocumentGenerationJob @relation(fields: [generationJobId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FormSubmission {
  id             String               @id @default(cuid())
  organizationId String
  formType       String
  status         FormSubmissionStatus @default(DRAFT)
  data           Json
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])
  lead         Lead?

  @@index([organizationId])
  @@index([formType])
  @@index([status])
}

model Lead {
  id                        String       @id @default(cuid())
  source                    LeadSource   @default(MANUAL)
  status                    LeadStatus   @default(NEW)
  priority                  LeadPriority @default(NORMAL)
  companyName               String
  fullName                  String
  email                     String
  phone                     String?
  nip                       String?
  industry                  String?
  companySize               String?
  estimatedValue            Decimal?     @db.Decimal(12, 2)
  consentMarketing          Boolean      @default(false)
  consentPrivacy            Boolean      @default(false)
  consentContact            Boolean      @default(false)
  iodCheckerResult          String?
  iodCheckerAnswersSnapshot Json?
  sourceDetails             Json?
  assignedToId              String?
  organizationId            String?
  formSubmissionId          String?      @unique
  convertedAt               DateTime?
  lastContactedAt           DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  contactPersons ContactPerson[]
  notes          CrmNote[]
  tasks          CrmTask[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([priority, createdAt])
  @@index([assignedToId])
  @@index([organizationId])
  @@index([email])
  @@index([companyName])
  @@index([nip])
}

model ContactPerson {
  id             String   @id @default(cuid())
  leadId         String?
  organizationId String?
  fullName       String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([organizationId])
  @@index([email])
}

model CrmNote {
  id             String            @id @default(cuid())
  leadId         String?
  organizationId String?
  authorId       String
  body           String
  visibility     CrmNoteVisibility @default(INTERNAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId])
}

model CrmTask {
  id               String        @id @default(cuid())
  leadId           String?
  organizationId   String?
  breachIncidentId String?
  title            String
  description      String?
  status           CrmTaskStatus @default(OPEN)
  priority         LeadPriority  @default(NORMAL)
  dueAt            DateTime?
  assignedToId     String?
  createdById      String
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  breachIncident DataBreachIncident? @relation(fields: [breachIncidentId], references: [id], onDelete: SetNull)
  assignedTo     User?               @relation("CrmTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, status])
  @@index([organizationId, status])
  @@index([breachIncidentId, status])
  @@index([assignedToId, status, dueAt])
  @@index([createdById])
  @@index([dueAt])
}

model DataBreachIncident {
  id                               String                   @id @default(cuid())
  organizationId                   String
  reportedById                     String
  assignedToId                     String?
  title                            String
  status                           DataBreachIncidentStatus @default(DRAFT)
  severity                         DataBreachSeverity       @default(MEDIUM)
  riskLevel                        DataBreachRiskLevel      @default(UNKNOWN)
  occurredAt                       DateTime?
  discoveredAt                     DateTime
  reportedAt                       DateTime?
  authorityNotificationDeadlineAt  DateTime
  closedAt                         DateTime?
  description                      String                   @db.Text
  affectedDataCategories           String[]                 @default([])
  affectedDataSubjectCategories    String[]                 @default([])
  approximateAffectedSubjects      Int?
  cause                            String?                  @db.Text
  consequences                     String?                  @db.Text
  measuresTaken                    String?                  @db.Text
  measuresPlanned                  String?                  @db.Text
  contactName                      String?
  contactEmail                     String?
  contactPhone                     String?
  authorityNotificationRequired    Boolean?
  dataSubjectsNotificationRequired Boolean?
  decisionRationale                String?                  @db.Text
  specialCategoryData              Boolean                  @default(false)
  childrenData                     Boolean                  @default(false)
  largeScale                       Boolean                  @default(false)
  identityTheftRisk                Boolean                  @default(false)
  encryptedData                    Boolean                  @default(false)
  accessRecovered                  Boolean                  @default(false)
  mitigationMeasuresApplied        Boolean                  @default(false)
  suggestedRiskLevel               DataBreachRiskLevel?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User                 @relation("BreachReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo   User?                @relation("BreachAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   DataBreachActivity[]
  tasks        CrmTask[]

  @@index([organizationId, status])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([status, authorityNotificationDeadlineAt])
  @@index([riskLevel, severity])
  @@index([createdAt])
}

model DataBreachActivity {
  id         String                       @id @default(cuid())
  incidentId String
  actorId    String?
  type       DataBreachActivityType
  title      String
  body       String?                      @db.Text
  visibility DataBreachActivityVisibility @default(INTERNAL)
  metadata   Json
  createdAt  DateTime                     @default(now())

  incident DataBreachIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?              @relation("BreachActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([actorId])
  @@index([visibility, createdAt])
}
