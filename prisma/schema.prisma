generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  OPERATOR
  CLIENT
  READ_ONLY
}

enum DocumentType {
  PRIVACY_POLICY
  RODO_POLICY
  PROCESSING_REGISTER
  PROCESSING_AGREEMENT
  DPIA
  COOKIE_POLICY
  DATA_BREACH_PROCEDURE
  DATA_SUBJECT_REQUEST_PROCEDURE
  CLEAN_DESK_POLICY
  IT_SECURITY_INSTRUCTION
  AUTHORIZATION_TEMPLATE
  TRAINING_MATERIAL
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  DELIVERED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadSource {
  IOD_CHECKER
  CONTACT_FORM
  MANUAL
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  TO_CONTACT
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  PROPOSAL_SENT
  CONVERTED
  WON
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrganizationStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CrmNoteVisibility {
  INTERNAL
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DataSubjectRequestType {
  ACCESS
  COPY
  RECTIFICATION
  ERASURE
  RESTRICTION
  PORTABILITY
  OBJECTION
  WITHDRAW_CONSENT
  AUTOMATED_DECISION
  OTHER
}

enum DataSubjectRequestStatus {
  DRAFT
  RECEIVED
  IDENTITY_VERIFICATION
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  RESPONSE_PREPARED
  RESPONDED
  REJECTED
  CLOSED
  CANCELLED
}

enum DataSubjectRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DataSubjectRequestVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  NOT_REQUIRED
}

enum DataSubjectRequestActivityType {
  CREATED
  SUBMITTED
  UPDATED
  STATUS_CHANGED
  IDENTITY_VERIFICATION_UPDATED
  RESPONSE_PREPARED
  RESPONSE_MARKED_SENT
  NOTE_ADDED
  TASK_CREATED
  CLOSED
}

enum DataSubjectRequestActivityVisibility {
  INTERNAL
  PUBLIC
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfiles     ClientProfile[]
  createdTemplates   DocumentTemplate[]           @relation("TemplateCreatedBy")
  approvedTemplates  DocumentTemplate[]           @relation("TemplateApprovedBy")
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]
  assignedLeads      Lead[]                       @relation("LeadAssignedTo")
  ownedOrganizations Organization[]               @relation("OrganizationOwner")
  authoredCrmNotes   CrmNote[]
  assignedCrmTasks   CrmTask[]                    @relation("CrmTaskAssignedTo")
  createdCrmTasks    CrmTask[]                    @relation("CrmTaskCreatedBy")
  reportedDsrs       DataSubjectRequest[]         @relation("DsrReportedBy")
  assignedDsrs       DataSubjectRequest[]         @relation("DsrAssignedTo")
  dsrActivities      DataSubjectRequestActivity[]
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  nip          String?
  regon        String?
  website      String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?            @default("PL")
  legalName    String?
  industry     String?
  size         String?
  status       OrganizationStatus @default(PROSPECT)
  ownerId      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner               User?                   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientProfiles      ClientProfile[]
  generationJobs      DocumentGenerationJob[]
  generatedDocuments  GeneratedDocument[]
  auditLogs           AuditLog[]
  formSubmissions     FormSubmission[]
  leads               Lead[]
  contactPersons      ContactPerson[]
  crmNotes            CrmNote[]
  crmTasks            CrmTask[]
  dataSubjectRequests DataSubjectRequest[]

  @@index([ownerId])
  @@index([status, createdAt])
  @@index([name])
  @@index([nip])
}

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model DocumentTemplate {
  id              String                 @id @default(cuid())
  type            DocumentType
  name            String
  version         Int
  status          DocumentTemplateStatus @default(DRAFT)
  fileKey         String
  variablesSchema Json
  createdById     String
  approvedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  createdBy          User                    @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?                   @relation("TemplateApprovedBy", fields: [approvedById], references: [id])
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@unique([type, version])
  @@index([status])
}

model DocumentGenerationJob {
  id             String                   @id @default(cuid())
  organizationId String
  templateId     String
  status         DocumentGenerationStatus @default(PENDING)
  inputSnapshot  Json
  errorMessage   String?
  createdById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  completedAt    DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id])
  template          DocumentTemplate   @relation(fields: [templateId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  generatedDocument GeneratedDocument?

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model GeneratedDocument {
  id              String                  @id @default(cuid())
  organizationId  String
  templateId      String
  templateVersion Int
  generationJobId String                  @unique
  type            DocumentType
  status          GeneratedDocumentStatus @default(DRAFT)
  inputSnapshot   Json
  docxFileKey     String
  pdfFileKey      String?
  zipFileKey      String?
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id])
  template      DocumentTemplate      @relation(fields: [templateId], references: [id])
  generationJob DocumentGenerationJob @relation(fields: [generationJobId], references: [id])
  createdBy     User                  @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FormSubmission {
  id             String               @id @default(cuid())
  organizationId String
  formType       String
  status         FormSubmissionStatus @default(DRAFT)
  data           Json
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])
  lead         Lead?

  @@index([organizationId])
  @@index([formType])
  @@index([status])
}

model Lead {
  id                        String       @id @default(cuid())
  source                    LeadSource   @default(MANUAL)
  status                    LeadStatus   @default(NEW)
  priority                  LeadPriority @default(NORMAL)
  companyName               String
  fullName                  String
  email                     String
  phone                     String?
  nip                       String?
  industry                  String?
  companySize               String?
  estimatedValue            Decimal?     @db.Decimal(12, 2)
  consentMarketing          Boolean      @default(false)
  consentPrivacy            Boolean      @default(false)
  consentContact            Boolean      @default(false)
  iodCheckerResult          String?
  iodCheckerAnswersSnapshot Json?
  sourceDetails             Json?
  assignedToId              String?
  organizationId            String?
  formSubmissionId          String?      @unique
  convertedAt               DateTime?
  lastContactedAt           DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  contactPersons ContactPerson[]
  notes          CrmNote[]
  tasks          CrmTask[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([priority, createdAt])
  @@index([assignedToId])
  @@index([organizationId])
  @@index([email])
  @@index([companyName])
  @@index([nip])
}

model ContactPerson {
  id             String   @id @default(cuid())
  leadId         String?
  organizationId String?
  fullName       String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([organizationId])
  @@index([email])
}

model CrmNote {
  id             String            @id @default(cuid())
  leadId         String?
  organizationId String?
  authorId       String
  body           String
  visibility     CrmNoteVisibility @default(INTERNAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId])
}

model CrmTask {
  id                   String        @id @default(cuid())
  leadId               String?
  organizationId       String?
  dataSubjectRequestId String?
  title                String
  description          String?
  status               CrmTaskStatus @default(OPEN)
  priority             LeadPriority  @default(NORMAL)
  dueAt                DateTime?
  assignedToId         String?
  createdById          String
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lead               Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  dataSubjectRequest DataSubjectRequest? @relation(fields: [dataSubjectRequestId], references: [id], onDelete: SetNull)
  assignedTo         User?               @relation("CrmTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, status])
  @@index([organizationId, status])
  @@index([dataSubjectRequestId, status])
  @@index([assignedToId, status, dueAt])
  @@index([createdById])
  @@index([dueAt])
}

model DataSubjectRequest {
  id                    String                               @id @default(cuid())
  organizationId        String
  reportedById          String?
  assignedToId          String?
  requesterName         String
  requesterEmail        String
  requesterPhone        String?
  relationship          String?
  type                  DataSubjectRequestType
  status                DataSubjectRequestStatus             @default(DRAFT)
  priority              DataSubjectRequestPriority           @default(NORMAL)
  requestDescription    String                               @db.Text
  requestChannel        String?                              @default("PORTAL")
  additionalInformation String?                              @db.Text
  receivedAt            DateTime?
  dueAt                 DateTime?
  extensionUntil        DateTime?
  extensionReason       String?                              @db.Text
  closedAt              DateTime?
  verificationStatus    DataSubjectRequestVerificationStatus @default(NOT_STARTED)
  verificationMethod    String?
  verificationNote      String?                              @db.Text
  verifiedAt            DateTime?
  responseSummary       String?                              @db.Text
  responseDraft         String?                              @db.Text
  responseDecision      String?
  responsePreparedAt    DateTime?
  responseSentAt        DateTime?
  decisionRationale     String?                              @db.Text
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User?                        @relation("DsrReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo   User?                        @relation("DsrAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   DataSubjectRequestActivity[]
  tasks        CrmTask[]

  @@index([organizationId, status, dueAt])
  @@index([reportedById, createdAt])
  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt])
  @@index([type, createdAt])
  @@index([requesterEmail])
}

model DataSubjectRequestActivity {
  id         String                               @id @default(cuid())
  requestId  String
  actorId    String?
  type       DataSubjectRequestActivityType
  visibility DataSubjectRequestActivityVisibility @default(INTERNAL)
  title      String
  note       String?                              @db.Text
  metadata   Json?
  createdAt  DateTime                             @default(now())

  request DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}
