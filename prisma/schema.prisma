  events    NewsletterEvent[]

  @@index([createdById])
  @@index([status, createdAt])
  @@index([scheduledAt])
}

model NewsletterEvent {
  id              String              @id @default(cuid())
  subscriberId    String?
  campaignId      String?
  type            NewsletterEventType
  provider        String?
  providerEventId String?
  metadata        Json?
  createdAt       DateTime            @default(now())

  campaign   NewsletterCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([subscriberId])
  @@index([campaignId])
  @@index([type, createdAt])
}

model MarketingEvent {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  leadId         String?
  orderId        String?
  blogPostId     String?
  subscriberId   String?
  eventType      String
  source         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  path           String?
  metadata       Json?
  createdAt      DateTime @default(now())

  blogPost     BlogPost?             @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subscriber   NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([leadId])
  @@index([orderId])
  @@index([blogPostId])
  @@index([subscriberId])
  @@index([eventType, createdAt])
  @@index([source])
}

model ConsentRecord {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  leadId         String?
  subscriberId   String?
  type           ConsentType
  status         ConsentStatus @default(GRANTED)
  source         String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  grantedAt      DateTime      @default(now())
  withdrawnAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lead         Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subscriber   NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([leadId])
  @@index([subscriberId])
  @@index([type, status])
}

model AutomationRule {
  id             String           @id @default(cuid())
  organizationId String?
  createdById    String?
  name           String
  status         AutomationStatus @default(DRAFT)
  trigger        String
  target         String
  conditions     Json?
  actions        Json
  idempotencyKey String?          @unique
  errorMessage   String?
  lastRunAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([trigger])
  @@index([lastRunAt])
}

model AutomationRun {
  id             String           @id @default(cuid())
  ruleId         String
  status         AutomationStatus @default(QUEUED)
  triggerEvent   String?
  target         String?
  idempotencyKey String?          @unique
  input          Json?
  output         Json?
  errorMessage   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status, createdAt])
}

model WorkflowEvent {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String?
  eventType      String
  target         String?
  status         AutomationStatus @default(QUEUED)
  idempotencyKey String           @unique
  payload        Json?
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model FileObject {
  id             String           @id @default(cuid())
  organizationId String?
  uploadedById   String?
  purpose        FilePurpose      @default(OTHER)
  status         FileObjectStatus @default(ACTIVE)
  provider       String           @default("r2")
  bucket         String?
  key            String           @unique
  fileName       String?
  mimeType       String?
  sizeBytes      Int?
  checksum       String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  breachAttachments      BreachAttachment[]
  dataSubjectAttachments DataSubjectRequestAttachment[]
  generatedDocumentFiles GeneratedDocumentFile[]
  organization           Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedBy             User?                          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([uploadedById])
  @@index([purpose, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FormSubmission {
  id             String               @id @default(cuid())
  organizationId String
  formType       String
  status         FormSubmissionStatus @default(DRAFT)
  data           Json
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  createdBy      User?           @relation(fields: [createdById], references: [id])
  documentInputs DocumentInput[]
  lead           Lead?
  organization   Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([formType])
  @@index([status])
  @@index([status, createdAt])
}
