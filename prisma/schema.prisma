generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  OPERATOR
  CLIENT
  READ_ONLY
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  DPO
  BILLING
  MEMBER
  VIEWER
}

enum OrganizationMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DocumentType {
  PRIVACY_POLICY
  RODO_POLICY
  PROCESSING_REGISTER
  PROCESSING_AGREEMENT
  DPIA
  COOKIE_POLICY
  DATA_BREACH_PROCEDURE
  DATA_SUBJECT_REQUEST_PROCEDURE
  CLEAN_DESK_POLICY
  IT_SECURITY_INSTRUCTION
  AUTHORIZATION_TEMPLATE
  TRAINING_MATERIAL
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  DELIVERED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadSource {
  IOD_CHECKER
  CONTACT_FORM
  NEWSLETTER
  CHECKOUT
  PARTNER
  MANUAL
  IMPORT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
  ARCHIVED
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  NOTE_ADDED
  EMAIL
  CALL
  MEETING
  FORM_SUBMITTED
  CONVERTED
  TASK_CREATED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum ProductType {
  DOCUMENT
  PACKAGE
  SERVICE
  SUBSCRIPTION
  CONSULTATION
  TRAINING
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
  EXPIRED
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  IN_FULFILLMENT
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  CANCELLED
  CORRECTED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DocumentInputStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  NEEDS_CORRECTION
  LOCKED
  ARCHIVED
}

enum DocumentReviewStatus {
  PENDING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum GeneratedFileType {
  DOCX
  PDF
  HTML
  ZIP
  OTHER
}

enum DocumentUpdateType {
  INPUT_CHANGE
  TEMPLATE_CHANGE
  FILE_REGENERATION
  LEGAL_REVIEW
  MANUAL_CORRECTION
}

enum BreachStatus {
  REPORTED
  TRIAGE
  ASSESSING_RISK
  NOTIFIABLE
  REPORTED_TO_AUTHORITY
  SUBJECTS_NOTIFIED
  MITIGATED
  CLOSED
}

enum BreachRiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum DataSubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  RESTRICTION
  PORTABILITY
  OBJECTION
  CONSENT_WITHDRAWAL
  OTHER
}

enum DataSubjectRequestStatus {
  RECEIVED
  VERIFYING_IDENTITY
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESPONDED
  REJECTED
  CLOSED
}

enum IdentityVerificationStatus {
  NOT_STARTED
  REQUESTED
  VERIFIED
  FAILED
  NOT_REQUIRED
}

enum IntakeChannel {
  EMAIL
  FORM
  PHONE
  LETTER
  IN_PERSON
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageThreadStatus {
  OPEN
  WAITING_FOR_CLIENT
  WAITING_FOR_PRIVAZY
  CLOSED
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
  ARCHIVED
}

enum NotificationType {
  SYSTEM
  TASK
  DOCUMENT
  BREACH
  DATA_SUBJECT_REQUEST
  PAYMENT
  AUTOMATION
}

enum BlogPostStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum NewsletterCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum NewsletterEventType {
  SUBSCRIBED
  CONFIRMED
  UNSUBSCRIBED
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  COMPLAINED
}

enum ConsentType {
  PRIVACY_POLICY
  TERMS
  MARKETING_EMAIL
  PROFILING
  CONTACT
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  ARCHIVED
}

enum FileObjectStatus {
  ACTIVE
  QUARANTINED
  DELETED
}

enum FilePurpose {
  DOCUMENT
  BREACH_ATTACHMENT
  DSR_ATTACHMENT
  MESSAGE_ATTACHMENT
  INVOICE
  CMS_ASSET
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs                AuditLog[]
  approvedTemplates        DocumentTemplate[]             @relation("TemplateApprovedBy")
  approvedTemplateVersions DocumentTemplateVersion[]      @relation("TemplateVersionApprovedBy")
  automationRules          AutomationRule[]
  blogPosts                BlogPost[]                     @relation("BlogPostAuthor")
  blogReviews              BlogPost[]                     @relation("BlogPostReviewer")
  blogRevisions            BlogRevision[]
  breachAssignments        BreachIncident[]               @relation("BreachAssignedTo")
  breachAttachments        BreachAttachment[]
  breachComments           BreachComment[]
  breachReports            BreachIncident[]               @relation("BreachReporter")
  breachTimelineEvents     BreachTimelineEvent[]
  carts                    Cart[]
  clientProfiles           ClientProfile[]
  consentRecords           ConsentRecord[]
  createdTemplates         DocumentTemplate[]             @relation("TemplateCreatedBy")
  createdTemplateVersions  DocumentTemplateVersion[]      @relation("TemplateVersionCreatedBy")
  crmTasks                 CrmTask[]
  dataSubjectAttachments   DataSubjectRequestAttachment[]
  dataSubjectComments      DataSubjectRequestComment[]
  dataSubjectEvents        DataSubjectRequestEvent[]
  dataSubjectRequests      DataSubjectRequest[]
  documentDownloads        DocumentDownload[]
  documentInputs           DocumentInput[]
  documentReviews          DocumentReview[]
  documentUpdates          DocumentUpdate[]
  formSubmissions          FormSubmission[]
  generatedDocuments       GeneratedDocument[]
  generationJobs           DocumentGenerationJob[]
  leadActivities           LeadActivity[]
  leadNotes                LeadNote[]
  marketingEvents          MarketingEvent[]
  messageThreads           MessageThread[]
  messages                 Message[]
  newsletterCampaigns      NewsletterCampaign[]
  notifications            Notification[]
  organizationInvites      OrganizationInvite[]
  organizationMemberships  OrganizationMember[]
  orders                   Order[]
  uploadedFiles            FileObject[]
  workflowEvents           WorkflowEvent[]
  ownedLeads               Lead[]                         @relation("LeadOwner")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  nip          String?
  regon        String?
  website      String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?  @default("PL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs             AuditLog[]
  automationRules       AutomationRule[]
  billingProfile        BillingProfile?
  breachIncidents       BreachIncident[]
  carts                 Cart[]
  clientProfiles        ClientProfile[]
  consentRecords        ConsentRecord[]
  contactPeople         ContactPerson[]
  convertedLeads        Lead[]                  @relation("LeadConvertedOrganization")
  crmTasks              CrmTask[]
  dataSubjectRequests   DataSubjectRequest[]
  documentDownloads     DocumentDownload[]
  documentInputs        DocumentInput[]
  files                 FileObject[]
  formSubmissions       FormSubmission[]
  generatedDocuments    GeneratedDocument[]
  generationJobs        DocumentGenerationJob[]
  invoices              Invoice[]
  leads                 Lead[]                  @relation("LeadOrganization")
  marketingEvents       MarketingEvent[]
  members               OrganizationMember[]
  messageThreads        MessageThread[]
  newsletterSubscribers NewsletterSubscriber[]
  notifications         Notification[]
  orders                Order[]
  organizationInvites   OrganizationInvite[]
  payments              Payment[]
  settings              OrganizationSettings?
  workflowEvents        WorkflowEvent[]
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole   @default(MEMBER)
  status         OrganizationMemberStatus @default(ACTIVE)
  title          String?
  isPrimary      Boolean                  @default(false)
  invitedAt      DateTime?
  joinedAt       DateTime?
  removedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([status, createdAt])
}

model OrganizationInvite {
  id             String                   @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationMemberRole   @default(MEMBER)
  status         OrganizationInviteStatus @default(PENDING)
  tokenHash      String                   @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  invitedBy    User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model OrganizationSettings {
  id                           String   @id @default(cuid())
  organizationId               String   @unique
  defaultCurrency              String   @default("PLN")
  defaultLocale                String   @default("pl-PL")
  breachNotificationEmail      String?
  dataRequestNotificationEmail String?
  documentRetentionDays        Int?
  settings                     Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BillingProfile {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  legalName         String
  taxId             String?
  vatEu             String?
  email             String?
  addressLine1      String?
  addressLine2      String?
  postalCode        String?
  city              String?
  country           String   @default("PL")
  invoiceProvider   String?
  providerAccountId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoices     Invoice[]
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([taxId])
  @@index([createdAt])
}

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  sortOrder   Int      @default(0)
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]

  @@index([sortOrder])
}

model Lead {
  id                      String     @id @default(cuid())
  ownerId                 String
  organizationId          String?
  convertedOrganizationId String?
  formSubmissionId        String?    @unique
  pipelineStageId         String?
  source                  LeadSource @default(MANUAL)
  status                  LeadStatus @default(NEW)
  companyName             String
  contactName             String?
  email                   String?
  phone                   String?
  nip                     String?
  industry                String?
  estimatedValueCents     Int?
  currency                String     @default("PLN")
  hot                     Boolean    @default(false)
  sourceDetail            String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmTerm                 String?
  utmContent              String?
  lastActivityAt          DateTime?
  convertedAt             DateTime?
  lostReason              String?
  metadata                Json?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  activities            LeadActivity[]
  consentRecords        ConsentRecord[]
  contactPeople         ContactPerson[]
  convertedOrganization Organization?    @relation("LeadConvertedOrganization", fields: [convertedOrganizationId], references: [id], onDelete: SetNull)
  crmTasks              CrmTask[]
  formSubmission        FormSubmission?  @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  marketingEvents       MarketingEvent[]
  notes                 LeadNote[]
  organization          Organization?    @relation("LeadOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  owner                 User             @relation("LeadOwner", fields: [ownerId], references: [id])
  pipelineStage         PipelineStage?   @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([organizationId])
  @@index([convertedOrganizationId])
  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([pipelineStageId])
  @@index([email])
  @@index([createdAt])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  actorId   String?
  type      LeadActivityType
  title     String
  body      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([actorId])
  @@index([type, createdAt])
  @@index([createdAt])
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  authorId   String?
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([authorId])
  @@index([createdAt])
}

model ContactPerson {
  id             String   @id @default(cuid())
  organizationId String?
  leadId         String?
  name           String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([email])
}

model CrmTask {
  id                   String       @id @default(cuid())
  organizationId       String?
  leadId               String?
  orderId              String?
  generatedDocumentId  String?
  breachIncidentId     String?
  dataSubjectRequestId String?
  ownerId              String?
  title                String
  description          String?
  status               TaskStatus   @default(OPEN)
  priority             TaskPriority @default(MEDIUM)
  dueDate              DateTime?
  completedAt          DateTime?
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  breachIncident     BreachIncident?     @relation(fields: [breachIncidentId], references: [id], onDelete: SetNull)
  dataSubjectRequest DataSubjectRequest? @relation(fields: [dataSubjectRequestId], references: [id], onDelete: SetNull)
  generatedDocument  GeneratedDocument?  @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  lead               Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([orderId])
  @@index([generatedDocumentId])
  @@index([breachIncidentId])
  @@index([dataSubjectRequestId])
  @@index([ownerId])
  @@index([status, createdAt])
  @@index([priority, dueDate])
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}

model Product {
  id                 String        @id @default(cuid())
  categoryId         String?
  documentTemplateId String?
  documentType       DocumentType?
  name               String
  slug               String        @unique
  status             ProductStatus @default(DRAFT)
  type               ProductType
  shortDescription   String?
  description        String?
  defaultCurrency    String        @default("PLN")
  sortOrder          Int           @default(0)
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  blogPosts        BlogPostProduct[]
  category         ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  documentTemplate DocumentTemplate?    @relation(fields: [documentTemplateId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  packageItems     ProductPackageItem[]
  variants         ProductVariant[]

  @@index([categoryId])
  @@index([documentTemplateId])
  @@index([status, createdAt])
  @@index([type, status])
  @@index([sortOrder])
}

model ProductVariant {
  id               String        @id @default(cuid())
  productId        String
  name             String
  sku              String?       @unique
  status           ProductStatus @default(DRAFT)
  currency         String        @default("PLN")
  netAmountCents   Int
  grossAmountCents Int
  vatRateBps       Int           @default(2300)
  vatAmountCents   Int
  fulfillmentDays  Int?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  packageItems ProductPackageItem[]
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status, createdAt])
}

model ProductPackage {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  status           ProductStatus @default(DRAFT)
  description      String?
  currency         String        @default("PLN")
  netAmountCents   Int
  grossAmountCents Int
  vatRateBps       Int           @default(2300)
  vatAmountCents   Int
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  cartItems  CartItem[]
  items      ProductPackageItem[]
  orderItems OrderItem[]

  @@index([status, createdAt])
}

model ProductPackageItem {
  id               String @id @default(cuid())
  packageId        String
  productId        String
  productVariantId String
  quantity         Int    @default(1)
  sortOrder        Int    @default(0)

  package        ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([packageId, productVariantId])
  @@index([productId])
  @@index([sortOrder])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  status         CouponStatus @default(ACTIVE)
  discountType   DiscountType
  discountValue  Int
  currency       String?
  startsAt       DateTime?
  expiresAt      DateTime?
  maxRedemptions Int?
  redeemedCount  Int          @default(0)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  carts  Cart[]
  orders Order[]

  @@index([status, expiresAt])
}

model Cart {
  id             String     @id @default(cuid())
  organizationId String?
  userId         String?
  couponId       String?
  status         CartStatus @default(OPEN)
  currency       String     @default("PLN")
  subtotalCents  Int        @default(0)
  discountCents  Int        @default(0)
  taxCents       Int        @default(0)
  totalCents     Int        @default(0)
  anonymousId    String?
  expiresAt      DateTime?
  convertedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  coupon       Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        CartItem[]
  orders       Order[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([couponId])
  @@index([status, createdAt])
}

model CartItem {
  id                   String   @id @default(cuid())
  cartId               String
  productVariantId     String?
  packageId            String?
  quantity             Int      @default(1)
  currency             String   @default("PLN")
  unitNetAmountCents   Int
  unitGrossAmountCents Int
  vatRateBps           Int      @default(2300)
  vatAmountCents       Int
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  package        ProductPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productVariantId])
  @@index([packageId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  organizationId String?
  userId         String?
  cartId         String?
  couponId       String?
  status         OrderStatus @default(PENDING_PAYMENT)
  currency       String      @default("PLN")
  subtotalCents  Int
  discountCents  Int         @default(0)
  taxCents       Int
  totalCents     Int
  billingEmail   String?
  customerNote   String?
  placedAt       DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cart            Cart?            @relation(fields: [cartId], references: [id], onDelete: SetNull)
  coupon          Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  crmTasks        CrmTask[]
  invoice         Invoice?
  items           OrderItem[]
  marketingEvents MarketingEvent[]
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  payments        Payment[]
  refunds         Refund[]
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([cartId])
  @@index([couponId])
  @@index([status, createdAt])
  @@index([placedAt])
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  productId             String?
  productVariantId      String?
  packageId             String?
  description           String
  quantity              Int      @default(1)
  currency              String   @default("PLN")
  unitNetAmountCents    Int
  unitGrossAmountCents  Int
  vatRateBps            Int      @default(2300)
