generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  OPERATOR
  CLIENT
  READ_ONLY
}

enum DocumentType {
  PRIVACY_POLICY
  RODO_POLICY
  PROCESSING_REGISTER
  PROCESSING_AGREEMENT
  DPIA
  COOKIE_POLICY
  DATA_BREACH_PROCEDURE
  DATA_SUBJECT_REQUEST_PROCEDURE
  CLEAN_DESK_POLICY
  IT_SECURITY_INSTRUCTION
  AUTHORIZATION_TEMPLATE
  TRAINING_MATERIAL
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  DELIVERED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ProductKind {
  DOCUMENT
  PACKAGE
  SERVICE
}

enum OrderStatus {
  DRAFT
  PLACED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum FulfillmentStatus {
  NOT_STARTED
  READY_FOR_INPUT
  WAITING_FOR_PAYMENT
  WAITING_FOR_INPUT
  INPUT_IN_PROGRESS
  INPUT_SUBMITTED
  GENERATION_PENDING
  GENERATED
  IN_PROGRESS
  IN_REVIEW
  READY
  DELIVERED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  SANDBOX
}

enum PaymentReviewStatus {
  UNREVIEWED
  REVIEWED
  FLAGGED
}

enum InvoiceStatus {
  NOT_REQUESTED
  REQUESTED
  ISSUED
  FAILED
  CANCELLED
}

enum InvoiceMode {
  MOCK
  SANDBOX
}

enum DocumentInputStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  LOCKED
  GENERATION_PENDING
  GENERATED
  NEEDS_CORRECTION
  CANCELLED
}

enum GeneratedDocumentReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum DocumentDownloadChannel {
  STAFF
  CLIENT
  SECURE_LINK
}

enum LeadSource {
  IOD_CHECKER
  CONTACT_FORM
  MANUAL
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  TO_CONTACT
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  PROPOSAL_SENT
  CONVERTED
  WON
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrganizationStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CrmNoteVisibility {
  INTERNAL
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DataBreachIncidentStatus {
  DRAFT
  REPORTED
  TRIAGE
  RISK_ASSESSMENT
  NOTIFICATION_REQUIRED
  NOTIFICATION_NOT_REQUIRED
  NOTIFIED_AUTHORITY
  NOTIFIED_DATA_SUBJECTS
  CLOSED
  CANCELLED
}

enum DataSubjectRequestType {
  ACCESS
  COPY
  RECTIFICATION
  ERASURE
  RESTRICTION
  PORTABILITY
  OBJECTION
  WITHDRAW_CONSENT
  AUTOMATED_DECISION
  OTHER
}

enum DataSubjectRequestStatus {
  DRAFT
  RECEIVED
  IDENTITY_VERIFICATION
  IN_PROGRESS
  WAITING_FOR_INFORMATION
  RESPONSE_PREPARED
  RESPONDED
  REJECTED
  CLOSED
  CANCELLED
}

enum DataBreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataBreachRiskLevel {
  LOW
  MEDIUM
  HIGH
  UNKNOWN
}

enum DataBreachActivityType {
  CREATED
  SUBMITTED
  UPDATED
  STATUS_CHANGED
  RISK_ASSESSMENT_UPDATED
  NOTIFICATION_DECISION_CHANGED
  NOTE_ADDED
  TASK_CREATED
  CLOSED
}

enum DataBreachActivityVisibility {
  INTERNAL
  PUBLIC
}

enum DataSubjectRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DataSubjectRequestVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  NOT_REQUIRED
}

enum DataSubjectRequestActivityType {
  CREATED
  SUBMITTED
  UPDATED
  STATUS_CHANGED
  IDENTITY_VERIFICATION_UPDATED
  RESPONSE_PREPARED
  RESPONSE_MARKED_SENT
  NOTE_ADDED
  TASK_CREATED
  CLOSED
}

enum DataSubjectRequestActivityVisibility {
  INTERNAL
  PUBLIC
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfiles     ClientProfile[]
  createdTemplates   DocumentTemplate[]           @relation("TemplateCreatedBy")
  approvedTemplates  DocumentTemplate[]           @relation("TemplateApprovedBy")
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs          AuditLog[]
  formSubmissions    FormSubmission[]
  createdInputs      DocumentInput[]              @relation("DocumentInputCreatedBy")
  updatedInputs      DocumentInput[]              @relation("DocumentInputUpdatedBy")
  submittedInputs    DocumentInput[]              @relation("DocumentInputSubmittedBy")
  assignedLeads      Lead[]                       @relation("LeadAssignedTo")
  ownedOrganizations Organization[]               @relation("OrganizationOwner")
  authoredCrmNotes   CrmNote[]
  assignedCrmTasks   CrmTask[]                    @relation("CrmTaskAssignedTo")
  createdCrmTasks    CrmTask[]                    @relation("CrmTaskCreatedBy")
  ownedOrders        Order[]                      @relation("OrderOwner")
  reviewedPayments   Payment[]                    @relation("PaymentReviewedBy")
  requestedInvoices  Invoice[]                    @relation("InvoiceRequestedBy")
  reviewedDocuments  GeneratedDocument[]          @relation("GeneratedDocumentReviewedBy")
  documentDownloads  DocumentDownload[]
  reportedBreaches   DataBreachIncident[]         @relation("BreachReportedBy")
  assignedBreaches   DataBreachIncident[]         @relation("BreachAssignedTo")
  breachActivities   DataBreachActivity[]         @relation("BreachActivityActor")
  reportedDsrs       DataSubjectRequest[]         @relation("DsrReportedBy")
  assignedDsrs       DataSubjectRequest[]         @relation("DsrAssignedTo")
  dsrActivities      DataSubjectRequestActivity[]
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  nip          String?
  regon        String?
  website      String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String?            @default("PL")
  legalName    String?
  industry     String?
  size         String?
  status       OrganizationStatus @default(PROSPECT)
  ownerId      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner               User?                   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientProfiles      ClientProfile[]
  generationJobs      DocumentGenerationJob[]
  generatedDocuments  GeneratedDocument[]
  auditLogs           AuditLog[]
  formSubmissions     FormSubmission[]
  leads               Lead[]
  contactPersons      ContactPerson[]
  crmNotes            CrmNote[]
  crmTasks            CrmTask[]
  orders              Order[]
  orderItems          OrderItem[]
  documentInputs      DocumentInput[]
  documentDownloads   DocumentDownload[]
  breachIncidents     DataBreachIncident[]
  dataSubjectRequests DataSubjectRequest[]

  @@index([ownerId])
  @@index([status, createdAt])
  @@index([name])
  @@index([nip])
}

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model DocumentTemplate {
  id              String                 @id @default(cuid())
  type            DocumentType
  name            String
  version         Int
  status          DocumentTemplateStatus @default(DRAFT)
  fileKey         String
  variablesSchema Json
  createdById     String
  approvedById    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  createdBy          User                    @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  approvedBy         User?                   @relation("TemplateApprovedBy", fields: [approvedById], references: [id])
  products           Product[]
  orderItems         OrderItem[]
  documentInputs     DocumentInput[]
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@unique([type, version])
  @@index([status])
}

model DocumentGenerationJob {
  id              String                   @id @default(cuid())
  organizationId  String
  templateId      String
  orderId         String?
  orderItemId     String?
  documentInputId String?
  status          DocumentGenerationStatus @default(PENDING)
  inputSnapshot   Json
  errorMessage    String?
  retryCount      Int                      @default(0)
  createdById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  completedAt     DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id])
  template          DocumentTemplate   @relation(fields: [templateId], references: [id])
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem         OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  documentInput     DocumentInput?     @relation(fields: [documentInputId], references: [id], onDelete: SetNull)
  createdBy         User               @relation(fields: [createdById], references: [id])
  generatedDocument GeneratedDocument?

  @@index([organizationId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([documentInputId])
  @@index([templateId])
  @@index([status])
}

model GeneratedDocument {
  id              String                        @id @default(cuid())
  organizationId  String
  templateId      String
  orderId         String?
  orderItemId     String?
  templateVersion Int
  generationJobId String                        @unique
  type            DocumentType
  status          GeneratedDocumentStatus       @default(DRAFT)
  reviewStatus    GeneratedDocumentReviewStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  inputSnapshot   Json
  docxFileKey     String
  pdfFileKey      String?
  zipFileKey      String?
  createdById     String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id])
  template      DocumentTemplate        @relation(fields: [templateId], references: [id])
  order         Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem     OrderItem?              @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  generationJob DocumentGenerationJob   @relation(fields: [generationJobId], references: [id])
  createdBy     User                    @relation(fields: [createdById], references: [id])
  reviewedBy    User?                   @relation("GeneratedDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  files         GeneratedDocumentFile[]
  downloads     DocumentDownload[]

  @@index([organizationId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([templateId])
  @@index([status])
  @@index([reviewStatus])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FormSubmission {
  id             String               @id @default(cuid())
  organizationId String
  formType       String
  status         FormSubmissionStatus @default(DRAFT)
  data           Json
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])
  lead         Lead?

  @@index([organizationId])
  @@index([formType])
  @@index([status])
}

model Product {
  id           String        @id @default(cuid())
  sku          String        @unique
  slug         String        @unique
  name         String
  description  String?
  kind         ProductKind   @default(DOCUMENT)
  status       ProductStatus @default(ACTIVE)
  templateId   String?
  documentType DocumentType?
  priceCents   Int
  vatRateBps   Int           @default(2300)
  currency     String        @default("PLN")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  documentInputs DocumentInput[]

  @@index([status, kind])
  @@index([documentType])
  @@index([templateId])
}

model Order {
  id                String            @id @default(cuid())
  orderNumber       String            @unique
  organizationId    String
  leadId            String?
  ownerId           String?
  status            OrderStatus       @default(PLACED)
  fulfillmentStatus FulfillmentStatus @default(WAITING_FOR_PAYMENT)
  paymentStatus     PaymentStatus     @default(PENDING)
  invoiceStatus     InvoiceStatus     @default(NOT_REQUESTED)
  customerEmail     String
  buyerName         String
  buyerTaxId        String?
  billingAddress    Json?
  totalNetCents     Int
  totalVatCents     Int
  totalGrossCents   Int
  currency          String            @default("PLN")
  source            String            @default("CRM")
  internalNote      String?
  paidAt            DateTime?
  cancelledAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead               Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner              User?                   @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  invoices           Invoice[]
  documentInputs     DocumentInput[]
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([ownerId])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([invoiceStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  organizationId    String
  productId         String?
  templateId        String?
  name              String
  documentType      DocumentType?
  quantity          Int               @default(1)
  unitNetCents      Int
  vatRateBps        Int               @default(2300)
  totalNetCents     Int
  totalVatCents     Int
  totalGrossCents   Int
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order              Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product            Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  template           DocumentTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  documentInput      DocumentInput?
  generationJobs     DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@index([orderId])
  @@index([organizationId])
  @@index([productId])
  @@index([templateId])
  @@index([documentType])
  @@index([fulfillmentStatus])
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProvider     @default(MOCK)
  providerPaymentId String?
  mode              InvoiceMode         @default(MOCK)
  status            PaymentStatus       @default(PENDING)
  reviewStatus      PaymentReviewStatus @default(UNREVIEWED)
  amountCents       Int
  currency          String              @default("PLN")
  idempotencyKey    String?
  payloadHash       String?
  safeError         String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User?          @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  events     PaymentEvent[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([reviewStatus])
  @@index([provider, providerPaymentId])
}

model PaymentEvent {
  id          String        @id @default(cuid())
  paymentId   String
  eventType   String
  status      PaymentStatus
  payloadHash String?
  safeSummary String?
  createdAt   DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([eventType])
}

model Invoice {
  id              String        @id @default(cuid())
  orderId         String
  invoiceNumber   String?
  status          InvoiceStatus @default(REQUESTED)
  mode            InvoiceMode   @default(MOCK)
  buyerName       String
  buyerTaxId      String?
  buyerEmail      String?
  totalNetCents   Int
  totalVatCents   Int
  totalGrossCents Int
  currency        String        @default("PLN")
  providerRef     String?
  externalUrl     String?
  payloadHash     String?
  safeError       String?
  requestedById   String?
  issuedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("InvoiceRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, createdAt])
  @@index([invoiceNumber])
}

model DocumentInput {
  id                String              @id @default(cuid())
  organizationId    String
  orderId           String?
  orderItemId       String              @unique
  productId         String?
  templateId        String
  templateVersion   Int?
  documentType      DocumentType
  status            DocumentInputStatus @default(DRAFT)
  dataJson          Json
  validationSummary Json?
  clientRevision    Int                 @default(1)
  createdById       String
  updatedById       String?
  submittedById     String?
  submittedAt       DateTime?
  lockedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order          Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem      OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product        Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  template       DocumentTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("DocumentInputCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?                   @relation("DocumentInputUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  submittedBy    User?                   @relation("DocumentInputSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  generationJobs DocumentGenerationJob[]

  @@index([organizationId])
  @@index([orderId])
  @@index([productId])
  @@index([templateId])
  @@index([status, updatedAt])
  @@index([createdById])
}

model GeneratedDocumentFile {
  id                  String   @id @default(cuid())
  generatedDocumentId String
  format              String
  fileKey             String
  fileName            String?
  contentType         String?
  sizeBytes           Int?
  createdAt           DateTime @default(now())

  generatedDocument GeneratedDocument  @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  downloads         DocumentDownload[]

  @@index([generatedDocumentId])
}

model DocumentDownload {
  id                  String                  @id @default(cuid())
  organizationId      String
  generatedDocumentId String?
  fileId              String?
  channel             DocumentDownloadChannel @default(STAFF)
  downloadedById      String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime                @default(now())

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  generatedDocument GeneratedDocument?     @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  file              GeneratedDocumentFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  downloadedBy      User?                  @relation(fields: [downloadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([generatedDocumentId])
  @@index([fileId])
  @@index([downloadedById])
}

model Lead {
  id                        String       @id @default(cuid())
  source                    LeadSource   @default(MANUAL)
  status                    LeadStatus   @default(NEW)
  priority                  LeadPriority @default(NORMAL)
  companyName               String
  fullName                  String
  email                     String
  phone                     String?
  nip                       String?
  industry                  String?
  companySize               String?
  estimatedValue            Decimal?     @db.Decimal(12, 2)
  consentMarketing          Boolean      @default(false)
  consentPrivacy            Boolean      @default(false)
  consentContact            Boolean      @default(false)
  iodCheckerResult          String?
  iodCheckerAnswersSnapshot Json?
  sourceDetails             Json?
  assignedToId              String?
  organizationId            String?
  formSubmissionId          String?      @unique
  convertedAt               DateTime?
  lastContactedAt           DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  assignedTo     User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  contactPersons ContactPerson[]
  notes          CrmNote[]
  tasks          CrmTask[]
  orders         Order[]

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@index([priority, createdAt])
  @@index([assignedToId])
  @@index([organizationId])
  @@index([email])
  @@index([companyName])
  @@index([nip])
}

model ContactPerson {
  id             String   @id @default(cuid())
  leadId         String?
  organizationId String?
  fullName       String
  email          String?
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([organizationId])
  @@index([email])
}

model CrmNote {
  id             String            @id @default(cuid())
  leadId         String?
  organizationId String?
  authorId       String
  body           String
  visibility     CrmNoteVisibility @default(INTERNAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorId])
}

model CrmTask {
  id                   String        @id @default(cuid())
  leadId               String?
  organizationId       String?
  breachIncidentId     String?
  dataSubjectRequestId String?
  title                String
  description          String?
  status               CrmTaskStatus @default(OPEN)
  priority             LeadPriority  @default(NORMAL)
  dueAt                DateTime?
  assignedToId         String?
  createdById          String
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  lead               Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  breachIncident     DataBreachIncident? @relation(fields: [breachIncidentId], references: [id], onDelete: SetNull)
  dataSubjectRequest DataSubjectRequest? @relation(fields: [dataSubjectRequestId], references: [id], onDelete: SetNull)
  assignedTo         User?               @relation("CrmTaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, status])
  @@index([organizationId, status])
  @@index([breachIncidentId, status])
  @@index([dataSubjectRequestId, status])
  @@index([assignedToId, status, dueAt])
  @@index([createdById])
  @@index([dueAt])
}

model DataBreachIncident {
  id                               String                   @id @default(cuid())
  organizationId                   String
  reportedById                     String
  assignedToId                     String?
  title                            String
  status                           DataBreachIncidentStatus @default(DRAFT)
  severity                         DataBreachSeverity       @default(MEDIUM)
  riskLevel                        DataBreachRiskLevel      @default(UNKNOWN)
  occurredAt                       DateTime?
  discoveredAt                     DateTime
  reportedAt                       DateTime?
  authorityNotificationDeadlineAt  DateTime
  closedAt                         DateTime?
  description                      String                   @db.Text
  affectedDataCategories           String[]                 @default([])
  affectedDataSubjectCategories    String[]                 @default([])
  approximateAffectedSubjects      Int?
  cause                            String?                  @db.Text
  consequences                     String?                  @db.Text
  measuresTaken                    String?                  @db.Text
  measuresPlanned                  String?                  @db.Text
  contactName                      String?
  contactEmail                     String?
  contactPhone                     String?
  authorityNotificationRequired    Boolean?
  dataSubjectsNotificationRequired Boolean?
  decisionRationale                String?                  @db.Text
  specialCategoryData              Boolean                  @default(false)
  childrenData                     Boolean                  @default(false)
  largeScale                       Boolean                  @default(false)
  identityTheftRisk                Boolean                  @default(false)
  encryptedData                    Boolean                  @default(false)
  accessRecovered                  Boolean                  @default(false)
  mitigationMeasuresApplied        Boolean                  @default(false)
  suggestedRiskLevel               DataBreachRiskLevel?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User                 @relation("BreachReportedBy", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo   User?                @relation("BreachAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   DataBreachActivity[]
  tasks        CrmTask[]

  @@index([organizationId, status])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([status, authorityNotificationDeadlineAt])
  @@index([riskLevel, severity])
  @@index([createdAt])
}

model DataBreachActivity {
  id         String                       @id @default(cuid())
  incidentId String
  actorId    String?
  type       DataBreachActivityType
  title      String
  body       String?                      @db.Text
  visibility DataBreachActivityVisibility @default(INTERNAL)
  metadata   Json
  createdAt  DateTime                     @default(now())

  incident DataBreachIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?              @relation("BreachActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([actorId])
  @@index([visibility, createdAt])
}

model DataSubjectRequest {
  id                    String                               @id @default(cuid())
  organizationId        String
  reportedById          String?
  assignedToId          String?
  requesterName         String
  requesterEmail        String
  requesterPhone        String?
  relationship          String?
  type                  DataSubjectRequestType
  status                DataSubjectRequestStatus             @default(DRAFT)
  priority              DataSubjectRequestPriority           @default(NORMAL)
  requestDescription    String                               @db.Text
  requestChannel        String?                              @default("PORTAL")
  additionalInformation String?                              @db.Text
  receivedAt            DateTime?
  dueAt                 DateTime?
  extensionUntil        DateTime?
  extensionReason       String?                              @db.Text
  closedAt              DateTime?
  verificationStatus    DataSubjectRequestVerificationStatus @default(NOT_STARTED)
  verificationMethod    String?
  verificationNote      String?                              @db.Text
  verifiedAt            DateTime?
  responseSummary       String?                              @db.Text
  responseDraft         String?                              @db.Text
  responseDecision      String?
  responsePreparedAt    DateTime?
  responseSentAt        DateTime?
  decisionRationale     String?                              @db.Text
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportedBy   User?                        @relation("DsrReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo   User?                        @relation("DsrAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   DataSubjectRequestActivity[]
  tasks        CrmTask[]

  @@index([organizationId, status, dueAt])
  @@index([reportedById, createdAt])
  @@index([assignedToId, status, dueAt])
  @@index([status, dueAt])
  @@index([type, createdAt])
  @@index([requesterEmail])
}

model DataSubjectRequestActivity {
  id         String                               @id @default(cuid())
  requestId  String
  actorId    String?
  type       DataSubjectRequestActivityType
  visibility DataSubjectRequestActivityVisibility @default(INTERNAL)
  title      String
  note       String?                              @db.Text
  metadata   Json?
  createdAt  DateTime                             @default(now())

  request DataSubjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}
