generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  LAWYER
  OPERATOR
  CLIENT
  READ_ONLY
}

enum DocumentType {
  PRIVACY_POLICY
  RODO_POLICY
  PROCESSING_REGISTER
  PROCESSING_AGREEMENT
  DPIA
  COOKIE_POLICY
  DATA_BREACH_PROCEDURE
  DATA_SUBJECT_REQUEST_PROCEDURE
  CLEAN_DESK_POLICY
  IT_SECURITY_INSTRUCTION
  AUTHORIZATION_TEMPLATE
  TRAINING_MATERIAL
}

enum DocumentTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  GENERATED
  DELIVERED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  DOCUMENT
  TEMPLATE
  PACKAGE
  SERVICE
  SUBSCRIPTION
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  MERGED
}

enum CustomerType {
  PERSON
  COMPANY
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  FULFILLING
  COMPLETED
  REFUNDED
}

enum OrderItemStatus {
  PENDING_PAYMENT
  INPUT_REQUIRED
  IN_PROGRESS
  READY
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  PRZELEWY24
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceProvider {
  MOCK
  EXTERNAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  FAILED
  CANCELLED
}

enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum CrmLeadStatus {
  NEW
  CONTACT_REQUIRED
  CONTACTED
  QUALIFIED
  OFFER_SENT
  WON
  LOST
  ARCHIVED
}

enum CrmPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum CrmActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  EMAIL
  CALL
  SYSTEM
}

enum CrmMessageStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

enum BreachIncidentStatus {
  NEW
  TRIAGE
  INVESTIGATING
  RISK_ASSESSMENT
  NOTIFICATION_REQUIRED
  NOTIFIED_AUTHORITY
  NOTIFIED_DATA_SUBJECTS
  CLOSED
  ARCHIVED
}

enum BreachRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataSubjectRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  RESTRICTION
  PORTABILITY
  OBJECTION
  CONSENT_WITHDRAWAL
  OTHER
}

enum DataSubjectRequestStatus {
  NEW
  IDENTITY_VERIFICATION
  IN_PROGRESS
  WAITING_FOR_CLIENT
  READY_FOR_REVIEW
  RESPONDED
  CLOSED
  ARCHIVED
}

enum ClientOrganizationRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
}

enum ClientMessageThreadStatus {
  OPEN
  CLOSED
}

enum ClientMessageSenderType {
  CLIENT
  PRIVAZY
  SYSTEM
}

enum ClientTimelineEventType {
  BREACH_CREATED
  REQUEST_CREATED
  DOCUMENT_FORM_SUBMITTED
  DOCUMENT_DOWNLOADED
  MESSAGE_SENT
  TASK_COMPLETED
  ORGANIZATION_UPDATED
  SYSTEM
}

enum BlogPostStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum BlogCtaType {
  CHECK_IOD
  SHOP_PRODUCT
  SERVICE_CONTACT
  NEWSLETTER
  CONSULTATION
  RELATED_ARTICLE
  NONE
}

enum NewsletterSubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum NewsletterEventType {
  SIGNUP
  CONFIRMATION_SENT
  CONFIRMED
  UNSUBSCRIBED
  CONSENT_UPDATED
}

enum MarketingEventType {
  ARTICLE_VIEW
  CTA_CLICK
  NEWSLETTER_SIGNUP
  CHECKER_START_FROM_ARTICLE
  PRODUCT_CLICK_FROM_ARTICLE
  LEAD_FROM_ARTICLE
}

enum EventLogStatus {
  PENDING
  DISPATCHED
  PROCESSED
  FAILED
  SKIPPED
}

enum AutomationRuleStatus {
  ACTIVE
  DISABLED
  DRY_RUN
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRY_PENDING
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationChannel {
  CRM
  PORTAL
  EMAIL
}

enum EmailLogStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfiles ClientProfile[]
  createdTemplates DocumentTemplate[] @relation("TemplateCreatedBy")
  approvedTemplates DocumentTemplate[] @relation("TemplateApprovedBy")
  generationJobs DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs AuditLog[]
  formSubmissions FormSubmission[]
  carts Cart[]
  orders Order[]
  billingProfiles BillingProfile[]
  ownedCrmLeads CrmLead[] @relation("CrmLeadOwner")
  assignedCrmTasks CrmTask[] @relation("CrmTaskOwner")
  createdCrmTasks CrmTask[] @relation("CrmTaskCreatedBy")
  createdCrmNotes CrmNote[] @relation("CrmNoteCreatedBy")
  crmActivities CrmActivity[] @relation("CrmActivityActor")
  createdCrmMessages CrmMessage[] @relation("CrmMessageCreatedBy")
  crmCalendarEvents CrmCalendarEvent[] @relation("CrmCalendarEventOwner")
  assignedBreachIncidents BreachIncident[] @relation("BreachIncidentAssignedTo")
  createdBreachIncidents BreachIncident[] @relation("BreachIncidentCreatedBy")
  assignedDataSubjectRequests DataSubjectRequest[] @relation("DataSubjectRequestAssignedTo")
  createdDataSubjectRequests DataSubjectRequest[] @relation("DataSubjectRequestCreatedBy")
  documentDownloads DocumentDownload[]
  clientTimelineEvents ClientTimelineEvent[] @relation("ClientTimelineActor")
  createdClientMessageThreads ClientMessageThread[] @relation("ClientMessageThreadCreatedBy")
  clientMessages ClientMessage[] @relation("ClientMessageSender")
  authoredBlogPosts BlogPost[] @relation("BlogPostAuthor")
  reviewedBlogPosts BlogPost[] @relation("BlogPostReviewer")
  changedBlogRevisions BlogRevision[] @relation("BlogRevisionChangedBy")
  newsletterEvents NewsletterEvent[] @relation("NewsletterEventActor")
  marketingEvents MarketingEvent[] @relation("MarketingEventActor")
  emittedEvents EventLog[] @relation("EventLogActor")
  automationRuns AutomationRun[] @relation("AutomationRunActor")
  notifications Notification[] @relation("NotificationUser")
  createdAutomationRules AutomationRule[] @relation("AutomationRuleCreatedBy")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  nip         String?
  regon       String?
  website     String?
  email       String?
  phone       String?
  addressLine1 String?
  addressLine2 String?
  postalCode  String?
  city        String?
  country     String?  @default("PL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientProfiles ClientProfile[]
  generationJobs DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]
  auditLogs AuditLog[]
  formSubmissions FormSubmission[]
  carts Cart[]
  orders Order[]
  billingProfiles BillingProfile[]
  invoices Invoice[]
  crmLeads CrmLead[]
  crmTasks CrmTask[]
  crmNotes CrmNote[]
  crmActivities CrmActivity[]
  crmMessages CrmMessage[]
  crmCalendarEvents CrmCalendarEvent[]
  breachIncidents BreachIncident[]
  dataSubjectRequests DataSubjectRequest[]
  documentDownloads DocumentDownload[]
  clientTimelineEvents ClientTimelineEvent[]
  clientMessageThreads ClientMessageThread[]
  clientMessages ClientMessage[]
  eventLogs EventLog[]
  automationRules AutomationRule[]
  automationRuns AutomationRun[]
  notifications Notification[]
  emailLogs EmailLog[]
  webhookEvents WebhookEvent[]
}

model ClientProfile {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           ClientOrganizationRole @default(MEMBER)
  invitedAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

model DocumentTemplate {
  id              String @id @default(cuid())
  type            DocumentType
  name            String
  version         Int
  status          DocumentTemplateStatus @default(DRAFT)
  fileKey         String
  variablesSchema Json
  createdById     String
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  approvedBy User? @relation("TemplateApprovedBy", fields: [approvedById], references: [id])
  generationJobs DocumentGenerationJob[]
  generatedDocuments GeneratedDocument[]

  @@unique([type, version])
  @@index([status])
}

model DocumentGenerationJob {
  id             String @id @default(cuid())
  organizationId String
  templateId     String
  status         DocumentGenerationStatus @default(PENDING)
  inputSnapshot  Json
  errorMessage   String?
  attempts       Int      @default(0)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  template DocumentTemplate @relation(fields: [templateId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])
  generatedDocument GeneratedDocument?

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model GeneratedDocument {
  id              String @id @default(cuid())
  organizationId  String
  templateId      String
  templateVersion Int
  generationJobId String @unique
  type            DocumentType
  status          GeneratedDocumentStatus @default(DRAFT)
  inputSnapshot   Json
  docxFileKey     String
  pdfFileKey      String?
  zipFileKey      String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  template DocumentTemplate @relation(fields: [templateId], references: [id])
  generationJob DocumentGenerationJob @relation(fields: [generationJobId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])
  downloads DocumentDownload[]

  @@index([organizationId])
  @@index([templateId])
  @@index([status])
}

model AuditLog {
  id             String @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entityType     String
  entityId       String
  metadata       Json
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FormSubmission {
  id             String @id @default(cuid())
  organizationId String
  orderItemId    String?
  formType       String
  status         FormSubmissionStatus @default(DRAFT)
  data           Json
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  createdBy User? @relation(fields: [createdById], references: [id])
  crmLead CrmLead?

  @@index([organizationId])
  @@index([orderItemId])
  @@index([formType])
  @@index([status])
}

model CrmLead {
  id               String        @id @default(cuid())
  organizationId   String
  formSubmissionId String?       @unique
  ownerId          String?
  status           CrmLeadStatus @default(NEW)
  priority         CrmPriority   @default(MEDIUM)
  source           String?
  utm              Json?
  valueCents       Int           @default(0)
  lostReason       String?
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  wonAt            DateTime?
  lostAt           DateTime?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formSubmission FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  owner User? @relation("CrmLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([priority])
  @@index([nextFollowUpAt])
}

model CrmTask {
  id             String        @id @default(cuid())
  organizationId String?
  ownerId        String?
  createdById    String?
  title          String
  description    String?
  status         CrmTaskStatus @default(OPEN)
  priority       CrmPriority   @default(MEDIUM)
  dueAt          DateTime?
  completedAt    DateTime?
  entityType     String?
  entityId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner User? @relation("CrmTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CrmTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([entityType, entityId])
}

model CrmNote {
  id             String   @id @default(cuid())
  organizationId String?
  createdById    String?
  body           String
  isInternal     Boolean  @default(true)
  entityType     String?
  entityId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CrmNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdById])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CrmActivity {
  id             String          @id @default(cuid())
  organizationId String?
  actorId        String?
  type           CrmActivityType @default(SYSTEM)
  action         String
  description    String?
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor User? @relation("CrmActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CrmMessage {
  id             String           @id @default(cuid())
  organizationId String?
  createdById    String?
  subject        String
  body           String
  fromEmail      String?
  toEmail        String
  status         CrmMessageStatus @default(DRAFT)
  entityType     String?
  entityId       String?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CrmMessageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CrmCalendarEvent {
  id             String   @id @default(cuid())
  organizationId String?
  ownerId        String?
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  status         String   @default("SCHEDULED")
  entityType     String?
  entityId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner User? @relation("CrmCalendarEventOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([startsAt])
  @@index([entityType, entityId])
}

model BreachIncident {
  id                    String               @id @default(cuid())
  organizationId        String
  incidentNumber        String               @unique
  title                 String
  summary               String?
  status                BreachIncidentStatus @default(NEW)
  riskLevel             BreachRiskLevel      @default(MEDIUM)
  detectedAt            DateTime
  occurredAt            DateTime?
  authorityDueAt        DateTime?
  dataSubjectsDueAt     DateTime?
  assignedToId          String?
  createdById           String?
  notifyAuthority       Boolean?
  notifyDataSubjects    Boolean?
  decisionNotes         String?
  closedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("BreachIncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy User? @relation("BreachIncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([riskLevel])
  @@index([authorityDueAt])
  @@index([assignedToId])
}

model DataSubjectRequest {
  id             String                   @id @default(cuid())
  organizationId String
  requestNumber  String                   @unique
  type           DataSubjectRequestType
  status         DataSubjectRequestStatus @default(NEW)
  subjectName    String
  subjectEmail   String?
  channel        String
  summary        String?
  receivedAt     DateTime
  dueAt          DateTime
  verifiedAt     DateTime?
  respondedAt    DateTime?
  assignedToId   String?
  createdById    String?
  responseSummary String?
  closedAt       DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("DataSubjectRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy User? @relation("DataSubjectRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([dueAt])
  @@index([assignedToId])
}

model DocumentDownload {
  id                  String   @id @default(cuid())
  organizationId      String
  generatedDocumentId String
  userId              String?
  fileType            String
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedDocument GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([generatedDocumentId])
  @@index([userId])
  @@index([createdAt])
}

model ClientTimelineEvent {
  id             String                  @id @default(cuid())
  organizationId String
  actorId        String?
  type           ClientTimelineEventType @default(SYSTEM)
  title          String
  body           String?
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor User? @relation("ClientTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ClientMessageThread {
  id                String                    @id @default(cuid())
  organizationId    String
  createdById       String?
  subject           String
  status            ClientMessageThreadStatus @default(OPEN)
  relatedEntityType String?
  relatedEntityId   String?
  lastMessageAt     DateTime                  @default(now())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ClientMessageThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  messages ClientMessage[]

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
  @@index([lastMessageAt])
}

model ClientMessage {
  id             String                  @id @default(cuid())
  threadId       String
  organizationId String
  senderUserId   String?
  senderType     ClientMessageSenderType
  body           String
  attachmentKeys Json?
  createdAt      DateTime                @default(now())

  thread ClientMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderUser User? @relation("ClientMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([organizationId])
  @@index([senderUserId])
  @@index([senderType])
  @@index([createdAt])
}

model BlogCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  posts BlogPost[]

  @@index([slug])
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPostTag[]

  @@index([slug])
}

model BlogPost {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  excerpt         String
  content         String
  status          BlogPostStatus @default(DRAFT)
  categoryId      String
  authorId        String?
  reviewerId      String?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  archivedAt      DateTime?
  seoTitle        String?
  metaDescription String
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  readingTime     Int           @default(5)
  legalDisclaimer String
  ctaType         BlogCtaType    @default(CHECK_IOD)
  source          String         @default("cms")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category BlogCategory @relation(fields: [categoryId], references: [id])
  author   User?        @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewer User?        @relation("BlogPostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]
  revisions BlogRevision[]
  faqItems BlogFaqItem[]
  ctas BlogCta[]
  relatedProducts BlogRelatedProduct[]
  relatedServices BlogRelatedService[]
  marketingEvents MarketingEvent[]

  @@index([categoryId])
  @@index([authorId])
  @@index([reviewerId])
  @@index([status, publishedAt])
  @@index([scheduledAt])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogRevision {
  id            String   @id @default(cuid())
  postId        String
  changedById   String?
  action        String
  changeSummary String?
  snapshot      Json
  createdAt     DateTime @default(now())

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  changedBy User?    @relation("BlogRevisionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([changedById])
  @@index([createdAt])
}

model BlogFaqItem {
  id        String   @id @default(cuid())
  postId    String
  question  String
  answer    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model BlogCta {
  id        String      @id @default(cuid())
  postId    String
  type      BlogCtaType
  label     String
  href      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([type])
}

model BlogRelatedProduct {
  postId    String
  productId String
  position  Int @default(0)

  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

model BlogRelatedService {
  id        String   @id @default(cuid())
  postId    String
  label     String
  href      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model NewsletterSubscriber {
  id               String                     @id @default(cuid())
  email            String                     @unique
  status           NewsletterSubscriberStatus @default(PENDING)
  source           String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  consentText      String
  consentAt        DateTime
  unsubscribeToken String                     @unique
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  events NewsletterEvent[]

  @@index([status])
  @@index([createdAt])
}

model NewsletterEvent {
  id           String              @id @default(cuid())
  subscriberId String
  actorId      String?
  type         NewsletterEventType
  metadata     Json
  createdAt    DateTime            @default(now())

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  actor      User?                @relation("NewsletterEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriberId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
}

model MarketingEvent {
  id             String             @id @default(cuid())
  type           MarketingEventType
  postId         String?
  actorId        String?
  source         String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  metadata       Json
  createdAt      DateTime           @default(now())

  post  BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  actor User?     @relation("MarketingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([postId])
  @@index([actorId])
  @@index([createdAt])
}

model EventLog {
  id             String         @id @default(cuid())
  eventType      String
  version        String         @default("v1")
  status         EventLogStatus @default(PENDING)
  idempotencyKey String         @unique
  payload        Json
  organizationId String?
  actorId        String?
  source         String?
  errorMessage   String?
  dispatchedAt   DateTime?
  processedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("EventLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  automationRuns AutomationRun[]

  @@index([eventType])
  @@index([status])
  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
}

model AutomationRule {
  id             String               @id @default(cuid())
  key            String               @unique
  name           String
  description    String?
  triggerEvent   String
  ownerRole      UserRole
  status         AutomationRuleStatus @default(ACTIVE)
  critical       Boolean              @default(false)
  maxAttempts    Int                  @default(3)
  config         Json?
  organizationId String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runs         AutomationRun[]

  @@index([triggerEvent])
  @@index([status])
  @@index([organizationId])
}

model AutomationRun {
  id             String              @id @default(cuid())
  ruleId         String?
  eventLogId     String?
  functionName   String
  status         AutomationRunStatus @default(QUEUED)
  idempotencyKey String              @unique
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  input          Json?
  output         Json?
  errorMessage   String?
  organizationId String?
  actorId        String?
  startedAt      DateTime?
  finishedAt     DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  rule         AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  eventLog     EventLog?       @relation(fields: [eventLogId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?           @relation("AutomationRunActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@index([eventLogId])
  @@index([functionName])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
}

model Notification {
  id             String              @id @default(cuid())
  userId         String?
  organizationId String?
  type           String
  channel        NotificationChannel @default(CRM)
  status         NotificationStatus  @default(UNREAD)
  title          String
  body           String?
  entityType     String?
  entityId       String?
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User?         @relation("NotificationUser", fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([channel])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model EmailLog {
  id             String         @id @default(cuid())
  recipient      String
  template       String
  status         EmailLogStatus @default(QUEUED)
  providerId     String?
  idempotencyKey String         @unique
  subject        String
  error          String?
  organizationId String?
  entityType     String?
  entityId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([recipient])
  @@index([template])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
}

model WebhookEvent {
  id              String             @id @default(cuid())
  provider        String
  externalEventId String
  status          WebhookEventStatus @default(RECEIVED)
  eventType       String?
  metadata        Json?
  organizationId  String?
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([provider])
  @@index([status])
  @@index([organizationId])
  @@index([createdAt])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String
  description      String
  status           ProductStatus @default(DRAFT)
  productType      ProductType
  priceNetCents    Int
  vatRateBps       Int           @default(2300)
  currency         String        @default("PLN")
  includedFiles    Json
  expectedDelivery String
  legalDisclaimer  String
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants ProductVariant[]
  cartItems CartItem[]
  orderItems OrderItem[]
  relatedBlogPosts BlogRelatedProduct[]

  @@index([status])
  @@index([productType])
}

model ProductVariant {
  id               String        @id @default(cuid())
  productId        String
  name             String
  slug             String
  status           ProductStatus @default(ACTIVE)
  priceNetCents    Int
  vatRateBps       Int           @default(2300)
  currency         String        @default("PLN")
  includedFiles    Json
  expectedDelivery String
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, slug])
  @@index([status])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  status         CouponStatus @default(ACTIVE)
  percentOffBps  Int?
  amountOffCents Int?
  currency       String       @default("PLN")
  maxRedemptions Int?
  redeemedCount  Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  carts Cart[]
  orders Order[]

  @@index([status])
  @@index([expiresAt])
}

model Cart {
  id             String     @id @default(cuid())
  sessionToken   String     @unique
  status         CartStatus @default(ACTIVE)
  userId         String?
  organizationId String?
  couponId       String?
  currency       String     @default("PLN")
  subtotalNetCents Int      @default(0)
  vatCents       Int        @default(0)
  discountCents  Int        @default(0)
  totalGrossCents Int       @default(0)
  expiresAt      DateTime?
  checkedOutAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
  items CartItem[]
  orders Order[]

  @@index([status])
  @@index([userId])
  @@index([organizationId])
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  productId      String
  variantId      String?
  quantity       Int      @default(1)
  unitNetCents   Int
  vatRateBps     Int
  currency       String   @default("PLN")
  productSnapshot Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model BillingProfile {
  id             String       @id @default(cuid())
  customerType   CustomerType
  organizationId String?
  userId         String?
  name           String
  email          String
  phone          String?
  companyName    String?
  nip            String?
  addressLine1   String
  addressLine2   String?
  postalCode     String
  city           String
  country        String       @default("PL")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  user User? @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([email])
  @@index([nip])
  @@index([organizationId])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  publicAccessToken String      @unique
  status            OrderStatus @default(PENDING_PAYMENT)
  userId            String?
  organizationId    String
  billingProfileId  String
  cartId            String?
  couponId          String?
  email             String
  phone             String?
  currency          String      @default("PLN")
  subtotalNetCents  Int
  vatCents          Int
  discountCents     Int         @default(0)
  totalGrossCents   Int
  source            Json?
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  billingProfile BillingProfile @relation(fields: [billingProfileId], references: [id])
  cart Cart? @relation(fields: [cartId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
  items OrderItem[]
  payments Payment[]
  invoices Invoice[]

  @@index([status])
  @@index([organizationId])
  @@index([billingProfileId])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  status          OrderItemStatus @default(PENDING_PAYMENT)
  productName     String
  productSlug     String
  productType     ProductType
  quantity        Int             @default(1)
  unitNetCents    Int
  vatRateBps      Int
  subtotalNetCents Int
  vatCents        Int
  totalGrossCents Int
  currency        String          @default("PLN")
  productSnapshot Json
  inputFormPath   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  formSubmissions FormSubmission[]

  @@index([orderId])
  @@index([status])
  @@index([productId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(MOCK)
  status            PaymentStatus   @default(PENDING)
  providerPaymentId String?
  idempotencyKey    String          @unique
  amountGrossCents  Int
  currency          String          @default("PLN")
  paymentUrl        String?
  rawProviderData   Json?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([provider, providerPaymentId])
}

model Invoice {
  id               String          @id @default(cuid())
  orderId          String
  organizationId   String
  provider         InvoiceProvider @default(MOCK)
  status           InvoiceStatus   @default(DRAFT)
  invoiceNumber    String          @unique
  externalInvoiceId String?
  externalUrl      String?
  buyerSnapshot    Json
  itemsSnapshot    Json
  subtotalNetCents Int
  vatCents         Int
  totalGrossCents  Int
  currency         String          @default("PLN")
  issuedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([orderId])
  @@index([organizationId])
  @@index([status])
}
